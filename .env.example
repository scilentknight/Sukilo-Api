APP_NAME=Sukilo API
APP_ENV=development
DEBUG=true

DATABASE_URL=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=product_images
DINOV2_MODEL=dinov2_vitl14
ENABLE_VECTOR_STACK=true

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
SEARCH_MIN_SIMILARITY=0.50

FRONTEND_URL=http://localhost:3000

# Authentication (required in production; ephemeral defaults used in development)
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=sukilo-api
# Development: generate an RSA keypair under secrets/ and point here.
# JWT_PRIVATE_KEY_REFERENCE=file:./secrets/jwt_dev_private.pem
# JWT_PUBLIC_KEY_SET={"dev":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"}
# JWT_ACTIVE_KEY_ID=dev
JWT_PRIVATE_KEY_REFERENCE=
JWT_PUBLIC_KEY_SET={}
JWT_ACTIVE_KEY_ID=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=600
AUTH_DIGEST_PEPPER_REFERENCE=
REDIS_URL=
SMTP_PROVIDER_REFERENCE=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_NAME=sukilo_refresh
AUTH_CSRF_COOKIE_NAME=sukilo_csrf
